{
  "name": "rizz-support",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official-style support center for Rizz — help articles, FAQs, ticket submission and tracking.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^1.67.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.5",
    "jsdom": "^27.4.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
